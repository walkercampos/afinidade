DATABASE_URL=postgresql://matchmaking:matchmaking@localhost:5432/matchmaking
TEST_DATABASE_URL=postgresql://matchmaking:matchmaking@localhost:5432/matchmaking_test
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Chave que cifra mensagens e fotos no banco. Guarde com cuidado: se for perdida ou
# trocada, as mensagens e fotos existentes deixam de poder ser lidas.
CHAVE_MENSAGENS=troque-por-outro-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRA_MIN=1440
# E-mail. As pessoas criam a conta com e-mail. No banco ficam só:
#   EMAIL_PEPPER -> HMAC do e-mail, para achar a conta;
#   CHAVE_EMAIL  -> e-mail cifrado, para o app poder mandar avisos.
# Gere como as outras; em produção, NÃO troque nenhuma das duas depois de ter usuários.
EMAIL_PEPPER=troque-por-mais-um-segredo-aleatorio-de-32-caracteres
CHAVE_EMAIL=troque-por-outro-segredo-aleatorio-de-32-caracteres-tb
# arquivo = desenvolvimento: cada e-mail vira um .txt em EMAIL_PASTA (abra para ver o código).
# Em produção: resend (RESEND_API_KEY) ou smtp (SMTP_HOST, SMTP_PORTA, SMTP_USUARIO, SMTP_SENHA).
EMAIL_PROVEDOR=arquivo
EMAIL_PASTA=emails-dev
EMAIL_REMETENTE=Afinidade <nao-responda@localhost>
# Base dos links do e-mail. Padrão: a primeira origem de WEBAUTHN_ORIGENS.
# APP_URL=http://localhost:8000
# RESEND_API_KEY=
# Passkeys (WebAuthn). RP_ID = só o domínio; ORIGENS = esquema + domínio + porta, exatamente
# como aparece na barra do navegador. Em produção são obrigatórias (o app não sobe sem elas).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGENS=http://localhost:8000
# "producao" (padrão): cookie Secure, HSTS, /docs desligado. Use "dev" só localmente, sem HTTPS.
AMBIENTE=dev
LIMITE_AUTH_POR_MIN=10
LIMITE_API_POR_MIN=120
LIMITE_MENSAGENS_POR_MIN=30
LIMITE_DENUNCIAS_POR_DIA=10
# Perfis sem atividade há mais dias que isso saem da descoberta
INATIVIDADE_MAX_DIAS=90
# Mensagens nunca lidas são apagadas depois deste prazo (as lidas somem 5 min após a leitura)
MENSAGENS_RETENCAO_DIAS=30
# Denunciantes distintos (contas com 24 h+) para ocultar um perfil até a revisão
DENUNCIAS_PARA_REVISAO=3
